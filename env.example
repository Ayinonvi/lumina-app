# ============================================================
# LUMINA — Variables d'environnement
# Copier ce fichier en .env.local pour le développement
# Ne jamais committer .env.local dans Git
# ============================================================

# --- SUPABASE ---
# Récupérer sur : https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role KEY — JAMAIS dans le frontend, uniquement dans les fonctions Netlify
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# --- GUMROAD ---
# Récupérer sur : https://app.gumroad.com/settings/advanced
# Application OAuth > Access Token
GUMROAD_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret pour valider les webhooks Gumroad (défini par toi dans les settings Gumroad)
GUMROAD_WEBHOOK_SECRET=ton_secret_webhook_gumroad
# ID du produit Lumina sur Gumroad (visible dans l'URL du produit)
GUMROAD_PRODUCT_ID=lumina

# --- RESEND (emails) ---
# Récupérer sur : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse d'envoi vérifiée sur Resend
RESEND_FROM_EMAIL=lumina@miely.fr
RESEND_FROM_NAME=Lumina by MIELY

# --- IA (Anthropic Claude) ---
# Récupérer sur : https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5

# --- ADMIN ---
# Email du compte administrateur (ton email)
ADMIN_EMAIL=naomi.kpoviessi@gmail.com

# --- SÉCURITÉ ---
# Clé secrète pour signer les tokens internes (générer avec : openssl rand -hex 32)
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- APP ---
VITE_APP_URL=https://lumina.miely.fr
